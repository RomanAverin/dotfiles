### Font
font-family = "JetBrainsMono Nerd Font"
font-style = "Light"
font-size = 13

### Shell
shell-integration = none
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
command = /usr/bin/zsh -lc 'exec tmux new-session -A -s main'

### Window
theme = charleston

window-padding-balance = true

# Let GTK/GNOME restore and manage window size.
# Fixed window-height/window-width are intentionally removed.

# Transparency + blur
background-opacity = 0.97
background-blur = true

unfocused-split-opacity = 1

### GTK
gtk-toolbar-style = raised-border
gtk-titlebar-hide-when-maximized = false
gtk-titlebar-style = native

# Use the normal GTK single-instance behavior.
# gtk-single-instance = false was intentionally removed.

### Scrollback
# Ghostty 1.4 compresses inactive scrollback automatically.
scrollback-limit-lines = 100000

### Cursor
cursor-style = bar
cursor-style-blink = true

### Keybind
# Ctrl+C copies when a selection can be copied;
# otherwise it is passed through to the application.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

### Notifications
desktop-notifications = false
app-notifications = false

### Clipboard
clipboard-write = allow
clipboard-read = ask

### Updates
auto-update = off
