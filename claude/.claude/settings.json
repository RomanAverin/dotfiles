{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "WebFetch",
      "WebSearch",
      "Edit(src/**)",
      "Read(repos/**)",
      "Edit(repos/**)",
      "Read(./.env.example)",
      "Edit(./.env.example)",
      "mcp__pencil"
    ],
    "deny": [
      "Read(./.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(secrets/**)",
      "Edit(./.env)",
      "Edit(.env.local)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "default"
  },
  "fallbackModel": [
    "claude-sonnet-5"
  ],
  "statusLine": {
    "type": "command",
    "command": "bash /home/rastler/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "git.cly.pw"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux if -F -t \"$TMUX_PANE\" '#{&&:#{window_active},#{session_attached}}' '' \"set -w -t $TMUX_PANE @agent_done 1\"; true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux if -F -t \"$TMUX_PANE\" '#{&&:#{window_active},#{session_attached}}' '' \"set -w -t $TMUX_PANE @agent_done 1\"; true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX_PANE\" ] && tmux set -wu -t \"$TMUX_PANE\" @agent_done; true"
          }
        ]
      }
    ]
  }
}